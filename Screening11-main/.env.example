# Free key from https://console.groq.com  (API Keys -> Create). Copy this file to .env and paste it below.
GROQ_API_KEY=

# Optional. Defaults are fine for the Groq free tier.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b   # tried in this order
# GROQ_TPM_LIMIT=8000       # your tokens-per-minute limit; raise it if your account allows more
# MAX_DECK_CHARS=12000      # read less of a deck than the free-tier limit would allow (default: as much as fits)
