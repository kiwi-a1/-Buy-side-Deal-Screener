# Add at least ONE AI key. You can add several: the app uses them in the order below and switches to the next one
# automatically when one is slow, rate-limited, out of credit or rejected. Keys can also be added in the app (AI keys page).
# Copy this file to .env and fill in what you have.
GROQ_API_KEY=            # free: https://console.groq.com
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=        # free tier: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=    # needs a model chosen on the AI keys page
# Any other OpenAI-compatible service (Mistral, Together, DeepSeek, a local Ollama, ...):
# LLM_CUSTOM_API_KEY=
# LLM_CUSTOM_BASE_URL=https://api.example.com/v1
# LLM_CUSTOM_MODEL=

# Optional tuning
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b   # Groq models, tried in this order
# GROQ_TPM_LIMIT=8000       # Groq tokens-per-minute; raise it if your account allows more
# LLM_TPM_OPENAI=           # same idea for any provider with a tight limit (LLM_TPM_<PROVIDER>)
# LLM_SOFT_TIMEOUT=60       # seconds before moving to the next key when another one is available
# LLM_TIMEOUT=120           # seconds the last remaining key may take
# MAX_INPUT_CHARS=48000     # source text per AI call for providers without a tight limit
# SERPER_API_KEY=           # optional: better web search than the free one

# Hosted use only (see DEPLOY.md)
# REQUIRE_LOGIN=1           # optional login for a hosted copy: set this AND APP_PASSWORD. Without it anyone with the web address can use the app and your AI keys
# APP_PASSWORD=
# SCREENING_DB=/data/screening.db
